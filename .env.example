# Copy this file to ".env" and fill in ONE provider.
# LLM_PROVIDER: mock | groq | openrouter | gemini | ollama | openai | anthropic
# Free, open-source models: groq (Llama, key at console.groq.com), openrouter (":free" models), ollama (local, no key)
# "mock" needs no key: every agent runs on its built-in rules (good for first run and offline demos).
LLM_PROVIDER=mock

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Local, free, private (install Ollama first, then: ollama pull llama3.1)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
